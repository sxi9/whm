# Copy to .env (development) or set in the systemd unit (production).

# Where the panel keeps its SQLite database, secret key and generated files.
# Production default: /var/lib/whm   Development default: ./data
WHM_DATA_DIR=./data

# HTTP listener (plain). 2086 mirrors WHM's HTTP port. HTTPS (2087) is enabled
# automatically when WHM_TLS_CERT and WHM_TLS_KEY are set.
WHM_HOST=0.0.0.0
WHM_PORT=2086
# WHM_TLS_PORT=2087
# WHM_TLS_CERT=/etc/whm/ssl/panel.crt
# WHM_TLS_KEY=/etc/whm/ssl/panel.key

# How privileged operations run:
#   split       -> the API process is non-root and talks to whm-agentd over WHM_AGENT_SOCKET
#   monolithic  -> the API process runs as root and executes agent ops in-process
WHM_MODE=monolithic
WHM_AGENT_SOCKET=/run/whm-agent.sock

# Set to create the initial administrator with a known password on first boot.
# Otherwise a random password is generated and written to $WHM_DATA_DIR/initial-admin-password.txt
# WHM_ADMIN_PASSWORD=

# Session cookie signing secret. Generated and persisted in the data dir when unset.
# WHM_SESSION_SECRET=

# Logging: fatal|error|warn|info|debug|trace
WHM_LOG_LEVEL=info

# Serve the built SPA from client/dist (production). In development the Vite dev
# server proxies /api to this process instead.
WHM_SERVE_CLIENT=false
