# Environment for whm-panel.service (installed to /etc/whm/panel.env, mode 0640 root:whmpanel).
NODE_ENV=production
WHM_CONFIG=/etc/whm/whm.conf
WHM_MODE=split
WHM_DATA_DIR=/var/lib/whm
WHM_AGENT_SOCKET=/run/whm-agent.sock
WHM_SERVE_CLIENT=true
WHM_LOG_LEVEL=info
# Set once before first boot to choose the initial root password; otherwise one is
# generated into /var/lib/whm/initial-admin-password.txt.
# WHM_ADMIN_PASSWORD=
# HTTPS is the default: with a TLS listener, port 2086 only answers 301 to https://<host>:2087
# (setting panel.force_https; /api/health and /.well-known/acme-challenge/ stay on HTTP).
# WHM_FORCE_HTTPS=false pins plain HTTP on 2086 (whm.conf forceHttps does the same); it never
# touches web.force_https, the per-site redirect toggled in Service Configuration > Apache Configuration.
# WHM_FORCE_HTTPS=false
# Panel certificate: whm.conf tlsCert/tlsKey point at /etc/whm/tls/cert.pem and key.pem, where the
# installer writes the self-signed pair and Change Hostname later installs the hostname certificate.
# These two override the file paths (the listener watches whichever pair it was started with).
# WHM_TLS_CERT=/etc/whm/tls/cert.pem
# WHM_TLS_KEY=/etc/whm/tls/key.pem
# Bootstrap license hub (https only). Unset = the vendor hub https://licserver.hostingsignal.in;
# the token's issuer wins once a license is active. Only the super admin (whm-cli superadmin)
# ever sees this address in the panel.
# WHM_LICENSE_HUB_URL=https://licserver.hostingsignal.in
# Super admin setup key (bcrypt hash written by `whm-cli superadmin --init`, 0600 root:root).
# Unset = next to the config file in use, i.e. /etc/whm/superadmin.key here, where the panel
# user cannot replace it. Read by whm-cli only; the panel process never opens it.
# WHM_SUPERADMIN_KEY_FILE=/etc/whm/superadmin.key
